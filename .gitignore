# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# dev database (embedded postgres) & file upload cục bộ
/.devdb
/uploads

# prisma client sinh tự động
/src/generated
/uploads-test
/test-results
/playwright-report

# thêm từ mẫu chung (giữ lại)
dist/
__pycache__/
.venv/
/.next-*/
/uploads-test-*/
