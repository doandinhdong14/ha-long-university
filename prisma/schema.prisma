// Schema theo mục 12.1 của docs/spec.md (v1.4), có chỉnh chi tiết, giữ ý nghĩa (xem NOTES.md, B18):
// - Prisma 7: generator "prisma-client", URL kết nối ở prisma.config.ts
// - Ngày kỳ lưu dạng @db.Date (ngày thuần, tính giờ VN ở src/lib/time.ts)
// - YeuCauThemTask có thêm kyId; ThongBao có maSuKien (chống gửi trùng nhắc việc)
// - KpiTask.capNhatLuc: thời điểm đổi trạng thái gần nhất (sắp xếp Hàng chờ "cũ nhất lên trước")
// - KetQuaKy.doiTuong: vị trí của người đó lúc chốt kỳ
// - onDelete: Restrict phía nhiệm vụ/task đã có người đăng ký/làm (lớp bảo vệ thứ hai, mục 8.2)
// v1.6 (docs/spec-v1.6.md mục 9.1): LoaiTask.CAI_TIEN, enum TrangThaiCaiTien, NhiemVu.laCaiTien,
// KetQuaKy.phanTramBatBuoc / tuDanhGia / trangThaiCaiTien. MO_RONG, GUI_CHOT, YeuCauThemTask giữ lại, không dùng nữa.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GV
  TBM
  TK
  HP
  HT
}

/// Vị trí làm KPI (đối tượng của nhiệm vụ, bảng xếp loại).
enum DoiTuong {
  GV
  TBM
  TK
  HP
}

enum LoaiTask {
  BAT_BUOC
  MO_RONG // v1.6: không còn dùng, giữ để không mất dữ liệu
  CAI_TIEN // v1.6: task duy nhất của nhiệm vụ cải tiến sáng tạo (+10%)
}

/// v1.6: trạng thái cải tiến sáng tạo trong kết quả kỳ.
enum TrangThaiCaiTien {
  KHONG_DANG_KY
  CHUA_CHOT
  DA_CHOT
}

enum TrangThaiDangKy {
  NHAP
  CHO_DUYET
  TU_CHOI
  DA_DUYET
}

enum TrangThaiTask {
  CHUA_LAM
  CHO_DUYET
  TU_CHOI
  DA_DUYET // đã duyệt, chưa chốt (treo)
  CHO_CHOT // đã gửi lên người chốt (treo) – không dùng cho task HP
  DA_CHOT // được tính hoàn thành
  TRA_VE // người chốt trả về người duyệt – không dùng cho task HP
}

enum TrangThaiDuyet {
  CHO_DUYET
  TU_CHOI
  DA_DUYET
}

enum KetQua {
  KHONG_DAT
  DAT
  VUOT
}

enum HanhDongTask {
  NOP
  SUA_BAI_NOP
  DUYET
  TU_CHOI
  HUY_DUYET
  GUI_CHOT // v1.6: không ghi nữa (bỏ bước Gửi lên), giữ cho lịch sử cũ
  CHOT
  TRA_VE
}

model Khoa {
  id         String  @id @default(cuid())
  ten        String
  hieuPhoId  String?
  hieuPho    User?   @relation("HieuPhoPhuTrach", fields: [hieuPhoId], references: [id], onDelete: SetNull)
  boMons     BoMon[]
  thanhViens User[]  @relation("ThanhVienKhoa")
}

model BoMon {
  id     String @id @default(cuid())
  ten    String
  khoaId String
  khoa   Khoa   @relation(fields: [khoaId], references: [id])
  users  User[]
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  hoTen             String
  role              Role
  passwordHash      String
  isDefaultPassword Boolean  @default(true)
  boMonId           String?
  boMon             BoMon?   @relation(fields: [boMonId], references: [id])
  khoaId            String?
  khoa              Khoa?    @relation("ThanhVienKhoa", fields: [khoaId], references: [id])
  createdAt         DateTime @default(now())

  khoaPhuTrach Khoa[]           @relation("HieuPhoPhuTrach")
  dangKys      DangKy[]
  kpiTasks     KpiTask[]
  yeuCaus      YeuCauThemTask[]
  ketQuas      KetQuaKy[]
  vanBanDaGui  VanBan[]
  vanBanDaXem  VanBanDaXem[]
  thongBaos    ThongBao[]

  @@index([role])
}

model Ky {
  id          String   @id @default(cuid())
  ten         String
  namHoc      String
  soKy        Int
  ngayBatDau  DateTime @db.Date
  ngayKetThuc DateTime @db.Date
  daCongBo    Boolean  @default(false)
  daChot      Boolean  @default(false)
  createdAt   DateTime @default(now())

  nhiemVus    NhiemVu[]
  bacXepLoais BacXepLoai[]
  dangKys     DangKy[]
  kpiTasks    KpiTask[]
  yeuCaus     YeuCauThemTask[]
  ketQuas     KetQuaKy[]

  @@unique([namHoc, soKy])
}

model BacXepLoai {
  id           String   @id @default(cuid())
  kyId         String
  ky           Ky       @relation(fields: [kyId], references: [id], onDelete: Cascade)
  doiTuong     DoiTuong
  ten          String
  diemToiThieu Int

  @@unique([kyId, doiTuong, ten])
}

model NhiemVu {
  id        String          @id @default(cuid())
  kyId      String
  ky        Ky              @relation(fields: [kyId], references: [id], onDelete: Cascade)
  doiTuong  DoiTuong
  ten       String
  moTa      String?
  diem      Int
  thuTu     Int             @default(0)
  /// v1.6: nhiệm vụ hệ thống "Đăng ký cải tiến sáng tạo" – mỗi (kỳ, vị trí) đúng 1, do damBaoNhiemVuCaiTien tạo.
  laCaiTien Boolean         @default(false)
  tasks     Task[]
  dangKys   DangKyNhiemVu[]

  @@index([kyId, doiTuong])
}

model Task {
  id        String           @id @default(cuid())
  nhiemVuId String
  nhiemVu   NhiemVu          @relation(fields: [nhiemVuId], references: [id], onDelete: Cascade)
  ten       String
  moTa      String?
  loai      LoaiTask         @default(BAT_BUOC)
  thuTu     Int              @default(0)
  kpiTasks  KpiTask[]
  yeuCaus   YeuCauThemTask[]
}

model DangKy {
  id           String          @id @default(cuid())
  kyId         String
  ky           Ky              @relation(fields: [kyId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trangThai    TrangThaiDangKy @default(NHAP)
  tongDiem     Int             @default(0)
  xepLoai      String?
  nhanXet      String?
  nguoiDuyetId String?
  nopLuc       DateTime?
  duyetLuc     DateTime?
  nhiemVus     DangKyNhiemVu[]

  @@unique([kyId, userId])
  @@index([kyId, trangThai])
}

model DangKyNhiemVu {
  dangKyId  String
  dangKy    DangKy  @relation(fields: [dangKyId], references: [id], onDelete: Cascade)
  nhiemVuId String
  nhiemVu   NhiemVu @relation(fields: [nhiemVuId], references: [id], onDelete: Restrict)

  @@id([dangKyId, nhiemVuId])
}

model KpiTask {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kyId        String
  ky          Ky            @relation(fields: [kyId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  trangThai   TrangThaiTask @default(CHUA_LAM)
  nhanXetChot String?
  nguoiChotId String?
  guiChotLuc  DateTime?
  chotLuc     DateTime?
  /// Thời điểm đổi trạng thái gần nhất (đặt trong mọi lần chuyển trạng thái).
  capNhatLuc  DateTime      @default(now())
  baiNops     BaiNop[]
  lichSus     LichSuTask[]

  @@unique([userId, taskId])
  @@index([kyId, userId])
  @@index([kyId, trangThai])
}

model BaiNop {
  id           String         @id @default(cuid())
  kpiTaskId    String
  kpiTask      KpiTask        @relation(fields: [kpiTaskId], references: [id], onDelete: Cascade)
  ghiChu       String?
  link         String?
  trangThai    TrangThaiDuyet @default(CHO_DUYET)
  nhanXet      String?
  nguoiDuyetId String?
  nopLuc       DateTime       @default(now())
  duyetLuc     DateTime?
  files        FileDinhKem[]

  @@index([kpiTaskId])
}

model LichSuTask {
  id              String       @id @default(cuid())
  kpiTaskId       String
  kpiTask         KpiTask      @relation(fields: [kpiTaskId], references: [id], onDelete: Cascade)
  hanhDong        HanhDongTask
  nguoiThucHienId String?
  nhanXet         String?
  luc             DateTime     @default(now())

  @@index([kpiTaskId])
}

model FileDinhKem {
  id        String   @id @default(cuid())
  tenGoc    String
  duongDan  String
  mimeType  String
  kichThuoc Int
  baiNopId  String?
  baiNop    BaiNop?  @relation(fields: [baiNopId], references: [id], onDelete: Cascade)
  vanBanId  String?
  vanBan    VanBan?  @relation(fields: [vanBanId], references: [id], onDelete: Cascade)
  taoLuc    DateTime @default(now())
}

model YeuCauThemTask {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kyId         String
  ky           Ky             @relation(fields: [kyId], references: [id], onDelete: Cascade)
  taskId       String
  task         Task           @relation(fields: [taskId], references: [id], onDelete: Restrict)
  trangThai    TrangThaiDuyet @default(CHO_DUYET)
  nhanXet      String?
  nguoiDuyetId String?
  taoLuc       DateTime       @default(now())
  duyetLuc     DateTime?

  @@index([kyId, trangThai])
}

model KetQuaKy {
  id               String           @id @default(cuid())
  kyId             String
  ky               Ky               @relation(fields: [kyId], references: [id], onDelete: Cascade)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Vị trí của người này lúc chốt kỳ.
  doiTuong         DoiTuong
  /// v1.6: tổng = % bắt buộc đã chốt + 10 nếu cải tiến đã chốt (tối đa 110).
  phanTram         Float
  /// v1.6: % task bắt buộc đã chốt.
  phanTramBatBuoc  Float            @default(0)
  /// v1.6: tự đánh giá = % task bắt buộc đã nộp + 10 nếu cải tiến đã nộp (tối đa 110).
  tuDanhGia        Float            @default(0)
  trangThaiCaiTien TrangThaiCaiTien @default(KHONG_DANG_KY)
  ketQua           KetQua
  xepLoai          String
  taskThieu        Json // [{ ten, nhiemVu, trangThai, lyDo }]
  taskVuot         Json // [{ ten, nhiemVu }] – v1.6: chỉ còn task cải tiến (khi đã chốt)
  soTreo           Int              @default(0)
  ghiChu           String?
  chotLuc          DateTime         @default(now())

  @@unique([kyId, userId])
}

model VanBan {
  id         String        @id @default(cuid())
  tieuDe     String
  noiDung    String
  viTriNhan  Role[] // GV, TBM, TK, HP, ADMIN
  nguoiGuiId String?
  nguoiGui   User?         @relation(fields: [nguoiGuiId], references: [id], onDelete: SetNull)
  guiLuc     DateTime      @default(now())
  files      FileDinhKem[]
  daXems     VanBanDaXem[]
}

model VanBanDaXem {
  vanBanId String
  vanBan   VanBan   @relation(fields: [vanBanId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  daXemLuc DateTime @default(now())

  @@id([vanBanId, userId])
}

model ThongBao {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noiDung  String
  link     String?
  daDoc    Boolean  @default(false)
  // Khóa chống trùng cho thông báo tự động (vd nhắc việc). NULL = không kiểm tra trùng.
  maSuKien String?
  taoLuc   DateTime @default(now())

  @@unique([userId, maSuKien])
  @@index([userId, daDoc])
}
